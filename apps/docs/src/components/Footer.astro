---
/*
 * Starlight's footer (edit link, last updated, previous and next page), then the
 * website's footer: the wordmark, links back to gentlemail.dev and who made it.
 * The docs are served on gentlemail.dev, so links to the website are root-relative.
 */
import Default from "@astrojs/starlight/components/Footer.astro";
import wordmarkSvg from "../assets/wordmark.svg?raw";

// The letters follow the text colour (paper in dark, ink in light); the dot stays lime.
const wordmark = wordmarkSvg.replaceAll('fill="#f5f5f0"', 'fill="currentColor"').replace("<svg ", '<svg role="img" aria-label="GentleMail" ');

const repo = "https://github.com/Softwaiz/gentlemail";
const links: [string, string][] = [
  ["/", "Website"],
  ["/#pricing", "Pricing"],
  ["/#compare", "Compare"],
  ["/docs/deploy/", "Deploy guide"],
  ["/docs/sdk/", "SDK"],
  ["/docs/changelog/", "Changelog"],
  [repo, "GitHub"],
  ["/llms.txt", "llms.txt"],
];
---

<Default />

<div class="gm-footer not-content">
  <div>
    <a href="/" class="gm-footer-logo" aria-label="GentleMail home" set:html={wordmark} />
    <p>Email like a gentleman.</p>
  </div>
  <nav aria-label="Footer">
    {links.map(([href, label]) => <a href={href}>{label}</a>)}
  </nav>
  <p class="gm-footer-made">
    Made by <a href="https://github.com/Softwaiz">Softwaiz</a>. Runs on Cloudflare Workers, D1, R2 and Email Routing.
  </p>
</div>

<style>
  .gm-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2.5rem;
    margin-top: 2.5rem;
    padding-block: 2rem 1rem;
    border-top: 1px solid var(--sl-color-hairline);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .gm-footer p {
    margin: 0;
  }
  .gm-footer .gm-footer-logo {
    display: inline-flex;
    color: var(--sl-color-white);
  }
  .gm-footer-logo :global(svg) {
    width: 152px;
    height: auto;
  }
  .gm-footer-logo + p {
    margin-top: 0.6rem;
    color: var(--sl-color-gray-2);
  }
  .gm-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .gm-footer a {
    color: inherit;
    text-decoration: none;
  }
  .gm-footer a:hover {
    color: var(--sl-color-white);
  }
  .gm-footer-made {
    width: 100%;
  }
  .gm-footer-made a {
    color: var(--sl-color-white);
  }
  .gm-footer-made a:hover {
    text-decoration: underline;
  }
</style>
