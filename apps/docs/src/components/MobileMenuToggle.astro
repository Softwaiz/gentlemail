---
/*
 * The phone menu button, as on gentlemail.dev: a square outlined button in the header whose
 * two bars turn into a cross while the menu is open. It opens Starlight's sidebar popover;
 * the menu's own motion is in styles/theme.css (Phone menu).
 */
---

<button popovertarget="starlight__sidebar" class="gm-menu-button md:sl-hidden print:hidden">
  <span class="gm-menu-icon" aria-hidden="true"><span></span><span></span></span>
  <span class="sr-only">{Astro.locals.t("menuButton.accessibleLabel")}</span>
</button>

<style>
  button {
    position: fixed;
    top: calc((var(--sl-nav-height) - 2.25rem) / 2);
    inset-inline-end: var(--sl-nav-pad-x);
    z-index: var(--sl-z-index-navbar);
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: transparent;
    color: var(--sl-color-white);
    cursor: pointer;
  }
  button:hover {
    background: var(--sl-color-gray-6);
  }
  /* From 50rem the sidebar is always shown, so there's no menu. */
  @media (min-width: 50rem) {
    button {
      display: none;
    }
  }

  /* Bars → cross. */
  .gm-menu-icon {
    position: relative;
    display: block;
    width: 18px;
    height: 12px;
  }
  .gm-menu-icon > span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }
  .gm-menu-icon > span:first-child {
    top: 2px;
  }
  .gm-menu-icon > span:last-child {
    bottom: 2px;
  }
  button:has(~ :popover-open) .gm-menu-icon > span:first-child {
    top: 5px;
    rotate: 45deg;
  }
  button:has(~ :popover-open) .gm-menu-icon > span:last-child {
    bottom: 5px;
    rotate: -45deg;
  }
  @media (prefers-reduced-motion: no-preference) {
    .gm-menu-icon > span {
      transition:
        rotate 320ms cubic-bezier(0.2, 0.8, 0.2, 1) 120ms,
        top 200ms ease,
        bottom 200ms ease;
    }
  }
</style>

<style is:global>
  /* The page behind doesn't scroll while the menu is open (phones only). */
  @media (max-width: 49.999rem) {
    body:has(#starlight__sidebar:popover-open) {
      overflow: hidden;
    }
  }
</style>
