{
  // The docs: static files only, no Worker code. Built pages live under dist/docs, so a
  // request for /docs/… (forwarded by the website through a service binding) maps to a file.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gentlemail-docs",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Reached through the website at /docs; no workers.dev address of its own.
  "workers_dev": false,
  "preview_urls": false
}
