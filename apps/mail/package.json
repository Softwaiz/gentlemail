{
  "name": "@emails/mail",
  "version": "0.7.0",
  "description": "Multi-mailbox webmail on Cloudflare (rwsdk, D1, R2, Email Service)",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "vite build",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "dev": "vite dev",
    "dev:init": "rw-scripts dev-init",
    "preview": "vite preview",
    "worker:run": "rw-scripts worker-run",
    "clean": "rm -rf ./node_modules/.vite",
    "release": "rw-scripts ensure-deploy-env && pnpm clean && pnpm db:migrate:remote && vite build && wrangler deploy",
    "generate": "rw-scripts ensure-env && wrangler types --include-runtime false",
    "check": "pnpm generate && pnpm types",
    "types": "tsc",
    "test": "vite build && node --test test/*.test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "node scripts/seed-local.mjs",
    "i18n": "lingui extract --clean --overwrite && lingui compile --typescript",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "compare-pages": "node scripts/compare-pages.mjs"
  },
  "dependencies": {
    "@fontsource-variable/google-sans": "^5.3.2",
    "@lexical/html": "0.53.0",
    "@lexical/link": "0.53.0",
    "@lexical/list": "0.53.0",
    "@lexical/react": "0.53.0",
    "@lexical/rich-text": "0.53.0",
    "@lexical/selection": "0.53.0",
    "@lexical/utils": "0.53.0",
    "@lingui/core": "6.12.0",
    "@lingui/react": "6.12.0",
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lexical": "0.53.0",
    "lucide-react": "^1.72.0",
    "motion": "14.10.1",
    "postal-mime": "4.2.1",
    "radix-ui": "^1.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "rwsdk": "1.7.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/workers-types": "5.20260801.1",
    "@lingui/cli": "6.12.0",
    "@lingui/vite-plugin": "6.12.0",
    "@storybook/addon-docs": "10.6.8",
    "@storybook/react-vite": "10.6.8",
    "@types/node": "~26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "miniflare": "5.20260730.0-alpha",
    "storybook": "10.6.8",
    "typescript": "7.0.2",
    "vite": "~8.2.0",
    "wrangler": "4.118.0"
  },
  "cloudflare": {
    "bindings": {
      "SETUP_TOKEN": {
        "description": "Any long random string. You type it once at `/setup` to create the first admin account. Generate one with `openssl rand -hex 32`."
      },
      "PUBLIC_URL": {
        "description": "The address the app is served on, for example `https://mail.example.com`. Used for links in webhook payloads. Leave empty to use relative links."
      },
      "APP_NAME": {
        "description": "The name shown in the interface and the browser tab."
      },
      "SPAM_SCORE_THRESHOLD": {
        "description": "Optional. Move mail to Spam when Cloudflare's spam score reaches this number. Leave empty to turn it off."
      }
    }
  }
}
