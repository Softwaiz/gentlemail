// ─────────────────────────────────────────────────────────────────────────────
// Deployment config. One shared instance serves any number of domains:
// domains and mailboxes are managed in the app's Admin page, not here.
// Values marked ◆ are specific to this deployment.
// ─────────────────────────────────────────────────────────────────────────────
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gentlemail", // ◆ Worker name (also the Email Routing catch-all target)
  "main": "src/worker.tsx",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // ◆ Hostname(s) the webmail UI is served on (any of them works)
  "routes": [
    { "pattern": "mailer.softwaiz.com", "custom_domain": true },
    { "pattern": "mail.kariboo.app", "custom_domain": true }
  ],

  // All mail, mailboxes, users and sessions
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kariboo-mail", // ◆
      "database_id": "d2d9a8ab-5aaf-4ed9-91bb-97acb840aee9", // ◆
      "migrations_dir": "migrations"
    }
  ],

  // Raw .eml files, attachments and oversized HTML bodies
  "r2_buckets": [
    {
      "binding": "MAIL_BUCKET",
      "bucket_name": "kariboo-mail" // ◆
    }
  ],

  // Cloudflare Email Service (outbound). No API key needed.
  "send_email": [{ "name": "EMAIL" }],

  "vars": {
    // ◆ Must match "name" above; used in the per-domain setup commands
    "WORKER_NAME": "gentlemail",
    // ◆ Name shown in the UI and browser tab
    "APP_NAME": "Mail"
  }
  // Secrets (set with `wrangler secret put`):
  //   SETUP_TOKEN — one-time token required to create the first admin at /setup
}
